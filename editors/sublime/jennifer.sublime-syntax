%YAML 1.2
---
# SPDX-License-Identifier: LGPL-3.0-only
# SPDX-FileCopyrightText: Copyright (C) 2026 mplx <mplx@jennifer-lang.dev>
#
# Sublime Text syntax for the Jennifer language (.j). Also consumed by
# `bat` (https://github.com/sharkdp/bat), which reads Sublime `.sublime-
# syntax` files: copy this into `$(bat --config-dir)/syntaxes/` and run
# `bat cache --build`. See editors/README.md.
name: Jennifer
version: 2
file_extensions:
  - j
first_line_match: '^#!.*\bjennifer\b'
scope: source.jennifer

contexts:
  main:
    - include: comments
    - include: strings
    - include: numbers
    - include: member
    - include: use
    - include: alias
    - include: namespace
    - include: field
    - include: keywords
    - include: types
    - include: language-constants
    - include: user-constants
    - include: type-names
    - include: variables
    - include: call
    - include: operators

  comments:
    - match: '\A#!.*$'
      scope: comment.line.shebang.jennifer
    # `# pragma-jennifer-version: >=0.25.0`, `# pragma-jennifer-capability: net`.
    - match: '#\s*(pragma-jennifer-[a-z]+):.*$'
      scope: comment.line.number-sign.jennifer
      captures:
        1: keyword.other.preprocessor.jennifer
    # `# lint-disable: L101`, `# lint-disable-file: L201`.
    - match: '#\s*(lint-disable(?:-file)?):.*$'
      scope: comment.line.number-sign.jennifer
      captures:
        1: keyword.other.directive.jennifer
    - match: '#.*$'
      scope: comment.line.number-sign.jennifer
    - match: '/\*\*(?!/)'
      scope: punctuation.definition.comment.begin.jennifer
      push: doc-comment
    - match: '/\*'
      scope: punctuation.definition.comment.begin.jennifer
      push: block-comment

  doc-comment:
    - meta_scope: comment.block.documentation.jennifer
    - match: '(?<=\s)@[a-z]+\b'
      scope: keyword.other.documentation.jennifer
    - match: '/\*'
      push: block-comment
    - match: '\*/'
      scope: punctuation.definition.comment.end.jennifer
      pop: true

  block-comment:
    - meta_scope: comment.block.jennifer
    # Block comments nest: push the same context on an inner `/*`.
    - match: '/\*'
      push: block-comment
    - match: '\*/'
      scope: punctuation.definition.comment.end.jennifer
      pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.jennifer
      push: double-string
    - match: "'"
      scope: punctuation.definition.string.begin.jennifer
      push: single-string

  double-string:
    - meta_scope: string.quoted.double.jennifer
    - match: '\\([nrt\\"''0{}]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})'
      scope: constant.character.escape.jennifer
    - match: '\\.?'
      scope: invalid.illegal.escape.jennifer
    - match: '\{'
      scope: punctuation.definition.template-expression.begin.jennifer
      push: interpolation
    # A bare } is a lex error; a literal brace is written \}.
    - match: '\}'
      scope: invalid.illegal.brace.jennifer
    - match: '"'
      scope: punctuation.definition.string.end.jennifer
      pop: true

  # A cooked-string interpolation slot: `{expr}`. Highlighted as embedded code
  # (the main context) until the closing brace; the slot may hold strings of
  # either kind.
  interpolation:
    - clear_scopes: 1
    - meta_scope: meta.template.expression.jennifer
    - match: '\}'
      scope: punctuation.definition.template-expression.end.jennifer
      pop: true
    - match: '\{'
      push: interpolation-braces
    - include: main

  # A brace pair inside a slot (a map literal), so its } does not end the slot.
  interpolation-braces:
    - match: '\}'
      pop: true
    - match: '\{'
      push: interpolation-braces
    - include: main

  # Single-quoted is raw: backslashes are literal (no escape scope), and the
  # string ends at the next '.
  single-string:
    - meta_scope: string.quoted.single.jennifer
    - match: "'"
      scope: punctuation.definition.string.end.jennifer
      pop: true

  numbers:
    - match: '\b0[xX][0-9a-fA-F](_?[0-9a-fA-F])*\b'
      scope: constant.numeric.hex.jennifer
    - match: '\b0[oO][0-7](_?[0-7])*\b'
      scope: constant.numeric.octal.jennifer
    - match: '\b0[bB][01](_?[01])*\b'
      scope: constant.numeric.binary.jennifer
    - match: '\b[0-9](_?[0-9])*(\.[0-9](_?[0-9])*([eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)\b'
      scope: constant.numeric.float.jennifer
    - match: '\b[0-9](_?[0-9])*\b'
      scope: constant.numeric.integer.jennifer

  # The name after a `.` is never a keyword: `strings.repeat(...)`,
  # `json.map()`, `$e.to`.
  member:
    - match: '\.\.'
      scope: keyword.operator.range.jennifer
    - match: '(\.)([A-Za-z][A-Za-z0-9_]*)(?=\s*\()'
      captures:
        1: punctuation.accessor.jennifer
        2: entity.name.function.jennifer
    - match: '(\.)([A-Z][A-Z0-9]*(?:_[A-Z][A-Z0-9]*)*)\b'
      captures:
        1: punctuation.accessor.jennifer
        2: variable.other.constant.jennifer
    - match: '(\.)([A-Z][A-Za-z0-9]*)'
      captures:
        1: punctuation.accessor.jennifer
        2: entity.name.type.jennifer
    - match: '(\.)([a-z][A-Za-z0-9]*)'
      captures:
        1: punctuation.accessor.jennifer
        2: variable.other.member.jennifer

  # The library after `use` is a namespace, even when it is also a type name
  # (`use task;`).
  use:
    - match: '\b(use)\s+([a-z][A-Za-z0-9]*)'
      captures:
        1: keyword.declaration.jennifer
        2: entity.name.namespace.jennifer

  # The alias in `use strings as str;` and `import "x.j" as x;`.
  alias:
    - match: '\b(as)\s+(?!(?:int|float|string|bool|bytes|list|map|task|func)\b)([a-z][A-Za-z0-9]*)(?=\s*;)'
      captures:
        1: keyword.declaration.jennifer
        2: entity.name.namespace.jennifer

  # A library or module prefix: the `io` in `io.printf`, the `task` in `task.wait`.
  namespace:
    - match: '\b[a-z][A-Za-z0-9]*(?=\.[A-Za-z])'
      scope: entity.name.namespace.jennifer

  # A field or binding name is never a keyword: `to as Point`, `Written{bytes: 0}`.
  field:
    - match: '\b[a-z][A-Za-z0-9]*(?=\s*:|\s+as\b)'
      scope: meta.name.jennifer

  keywords:
    - match: '\b(if|elseif|else|while|for|in|repeat|until|match|when|break|continue|return|exit|try|catch|throw|defer|errdefer|spawn)\b'
      scope: keyword.control.jennifer
    - match: '\b(export|def|const|func|struct|enum|use|include|import|as|of|to|init)\b'
      scope: keyword.declaration.jennifer
    - match: '\b(and|or|not)\b'
      scope: keyword.operator.word.jennifer
    - match: '\blen\b'
      scope: support.function.builtin.jennifer

  types:
    - match: '\b(int|float|string|bool|bytes|list|map|task)\b'
      scope: storage.type.jennifer
    # `channel` is a type only in `channel of T`.
    - match: '\bchannel(?=\s+of\b)'
      scope: storage.type.jennifer

  language-constants:
    - match: '\b(true|false|null)\b'
      scope: constant.language.jennifer

  user-constants:
    # UPPER_CASE constant names: chunks of A-Z (and digits) joined by single underscores.
    - match: '\b[A-Z][A-Z0-9]*(_[A-Z][A-Z0-9]*)*\b'
      scope: variable.other.constant.jennifer

  type-names:
    # CamelCase struct, enum and variant names: `Point`, `Shape.Circle`, `Error`.
    - match: '\b[A-Z][A-Za-z0-9]*\b'
      scope: entity.name.type.jennifer

  variables:
    # Use-site variable references carry the `$` sigil.
    - match: '\$[A-Za-z][A-Za-z0-9]*'
      scope: variable.other.jennifer

  call:
    # Bare `name(` function calls.
    - match: '\b([a-z][A-Za-z0-9]*)\s*(?=\()'
      captures:
        1: entity.name.function.jennifer

  operators:
    - match: '(//|<<|>>|<=|>=|==|!=|[-+*/%&|\^~<>=])'
      scope: keyword.operator.jennifer
