# Build outputs of `make build` / `make build-tinygo-dev` at the repo root
# (anchored, so cmd/jennifer/ and other paths named jennifer are not matched).
/jennifer
/jennifer-tiny
/jennifer-tiny-dev

# Generated by scripts/gen-version.sh on every build.
/internal/version/version_gen.go

# Generated at docs-build time (docs.yml), never committed: the module API
# reference (scripts/gen-module-docs.j), the coverage page
# (scripts/gen-coverage-docs.sh) and the Grimoire book (grimoire.toml).
/docs/api/
/docs/technical/coverage.md
/book-output/
