#
# AUR PKGBUILD for `jennifer-git`: clones the upstream repository
# and builds the standard-Go `jennifer` binary from source. Tracks the
# `main` branch; rebuild to follow upstream.
#
# The TinyGo `jennifer-tiny` binary is not built here for now. Arch currently
# ships Go 1.27 and TinyGo 0.42; TinyGo 0.42 does compile Jennifer against Go
# 1.27 (so the Go version is no longer the blocker), but 0.42 has scheduler
# regressions on linux/amd64 that stop a working `jennifer-tiny`. The Makefile
# pins `-scheduler=tasks` because Jennifer's recursive-`spawn` tree-walker needs
# a cooperative scheduler whose goroutine stacks `-stack-size` governs; under
# 0.42 that link step fails (duplicate symbol `tinygo_task_exit`), and the other
# cooperative scheduler `-scheduler=asyncify` fails to compile
# (`undefined: task.SystemStack` in the runtime GC). The default
# `-scheduler=threads` does build but crashes on recursive `spawn` (Boehm GC
# mark-stack overflow), so it is not a usable substitute. These failures
# reproduce under both Go 1.26 and Go 1.27, and in the official upstream
# `tinygo/tinygo:0.42.0` image on a trivial goroutine program - i.e. they are
# upstream TinyGo bugs (not Arch packaging, not a Go-version mismatch, not
# Jennifer's code). The `-scheduler=tasks` link failure is
# `//export tinygo_task_exit` in TinyGo's `internal/task/task_stack.go` being
# emitted into both the cached runtime object and the program object; it still
# reproduces on `tinygo/tinygo-dev` (0.43.0-dev), so the next release will not
# fix it on its own (the 0.42 UEFI-scheduler work in tinygo PR 5553 addressed
# only the none-scheduler UEFI path, not this one). Tracked upstream at
# https://github.com/tinygo-org/tinygo/issues/5652. The standard-Go `jennifer`
# is unaffected. Only the
# default `jennifer` is packaged until that issue is fixed and a TinyGo release
# restores a working cooperative scheduler (`tasks` or `asyncify`) for
# linux/amd64; re-enable the `build-tinygo` half of `make build` and the tiny
# install lines below once it does.
#
# Maintainer: mplx <jennifer@mplx.dev>

pkgname=jennifer-git
_realname=jennifer
pkgver=0.14.0.r0.g0000000
pkgrel=1
pkgdesc='Jennifer programming language interpreter (built from source)'
arch=('x86_64' 'aarch64')
url='https://github.com/jennifer-language/jennifer'
license=('LGPL3')
provides=('jennifer')
conflicts=('jennifer' 'jennifer-bin')
# `tinygo` is intentionally omitted: TinyGo 0.42's scheduler regressions on
# linux/amd64 prevent a working `jennifer-tiny`, so it is not built here (see
# the header note).
makedepends=('git' 'go')
optdepends=(
    'shared-mime-info: registers the .j file extension with file managers'
    'vim: syntax highlighting for .j files'
    'bat: syntax highlighting for .j files (run `bat cache --build` after install)'
)
install='jennifer.install'
source=("$_realname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_realname"
    # Format: <last-tag-without-v>.r<commits-since>.g<short-sha>
    # Sortable per Arch's vercmp; matches the AUR -git convention.
    git describe --long --tags --abbrev=7 2>/dev/null \
        | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g' \
        || printf 'r%s.%s' \
            "$(git rev-list --count HEAD)" \
            "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$srcdir/$_realname"
    # -trimpath drops the local $srcdir path from the binary (makepkg flags a
    # $srcdir reference otherwise); the plain dev `make build` keeps symbols,
    # so the packaged build asks for the release flag explicitly.
    #
    # `build-go` builds only the standard-Go `jennifer`. The TinyGo
    # `jennifer-tiny` half is skipped until a TinyGo release restores a working
    # cooperative scheduler on linux/amd64 (see the header note); switch back to
    # `make build` to restore both binaries.
    make build-go GOBUILDFLAGS=-trimpath
}

check() {
    cd "$srcdir/$_realname"
    go test ./...
}

package() {
    cd "$srcdir/$_realname"

    # Binary. `jennifer-tiny` is not built here (TinyGo 0.42 scheduler
    # regressions; see the header note), so only the default binary installs.
    install -Dm755 jennifer      "$pkgdir/usr/bin/jennifer"

    # Man page. The jennifer-tiny.1 page is skipped alongside its binary.
    install -Dm644 packaging/man/jennifer.1      "$pkgdir/usr/share/man/man1/jennifer.1"
    gzip -9n "$pkgdir/usr/share/man/man1/jennifer.1"

    # XDG MIME info for the .j extension.
    install -Dm644 packaging/mime/jennifer.xml \
        "$pkgdir/usr/share/mime/packages/jennifer.xml"

    # Bash completion. The jennifer-tiny symlink is omitted with its binary.
    install -Dm644 packaging/completions/jennifer.bash \
        "$pkgdir/usr/share/bash-completion/completions/jennifer"

    # Vim / Neovim syntax highlighting, so `.j` files highlight with no user
    # setup. Vim and Neovim read separate runtimepaths (/usr/share/vim/vimfiles
    # vs /usr/share/nvim/site), so install a copy under each.
    install -Dm644 editors/vim/syntax/jennifer.vim \
        "$pkgdir/usr/share/vim/vimfiles/syntax/jennifer.vim"
    install -Dm644 editors/vim/ftdetect/jennifer.vim \
        "$pkgdir/usr/share/vim/vimfiles/ftdetect/jennifer.vim"
    install -Dm644 editors/vim/syntax/jennifer.vim \
        "$pkgdir/usr/share/nvim/site/syntax/jennifer.vim"
    install -Dm644 editors/vim/ftdetect/jennifer.vim \
        "$pkgdir/usr/share/nvim/site/ftdetect/jennifer.vim"

    # Sublime Text / bat syntax. bat compiles syntaxes into a per-user cache,
    # so it can't auto-activate from here; the user copies it to
    # `$(bat --config-dir)/syntaxes/` and runs `bat cache --build`.
    install -Dm644 editors/sublime/jennifer.sublime-syntax \
        "$pkgdir/usr/share/jennifer/syntaxes/jennifer.sublime-syntax"

    # Jennifer-coded library modules: bare `import "name.j";` resolves under the
    # system module directory. Ship the modules and their include-partials, not
    # the *_test.j overlays (development-only).
    install -dm755 "$pkgdir/usr/share/jennifer/modules"
    for m in modules/*.j; do
        [[ "$m" == *_test.j ]] && continue
        install -m644 "$m" "$pkgdir/usr/share/jennifer/modules/"
    done

    # Language reference for coding assistants (also a human quick-reference).
    install -Dm644 JENNIFER.md "$pkgdir/usr/share/doc/jennifer/JENNIFER.md"
}
